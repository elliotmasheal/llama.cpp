#version 450

// Strided copy: each invocation moves 4 words taken 1 `stride` words apart, so a
// single dispatch keeps thousands of independent host-memory read streams in
// flight. Used to test whether GPU-driven copies beat the SDMA ceiling.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer SRC { uint s[]; } srcB;
layout(set = 0, binding = 1) buffer DST { uint d[]; } dstB;

layout(push_constant) uniform PC {
    uint base;
    uint stride;
} pc;

void main() {
    uint i = pc.base + gl_GlobalInvocationID.x;
    uint a = srcB.s[i];
    uint b = srcB.s[i + pc.stride];
    uint c = srcB.s[i + 2u * pc.stride];
    uint e = srcB.s[i + 3u * pc.stride];
    dstB.d[i] = a;
    dstB.d[i + pc.stride] = b;
    dstB.d[i + 2u * pc.stride] = c;
    dstB.d[i + 3u * pc.stride] = e;
}
