#version 450
// Q4_K (weights) x Q8_1 (activations) int8 dot GEMM. Each lane owns Q4K_ROWS rows and
// Q4K_TOKENS tokens, so one activation word feeds Q4K_ROWS dots and one weight word feeds
// Q4K_TOKENS dots. Byte layouts follow ggml/src/ggml-common.h block_q4_K (line 337) and
// block_q8_1 (line 268), read as 32-bit words so no compiler padding is assumed. Folding of
// scales, mins and the q8_1 block sum is derived in README.md.

#extension GL_EXT_control_flow_attributes : enable
#ifdef Q4K_DOT4
#extension GL_EXT_integer_dot_product : require
#endif

#include "q4k-tiles.h"

layout(local_size_x = Q4K_WG_INVOCATIONS) in;

layout(binding = 0) readonly  buffer WeightWords { uint w[]; } wt;
layout(binding = 1) readonly  buffer ActQs       { uvec4 aq[]; } aq;
layout(binding = 2) writeonly buffer Out         { float o[]; } ob;
layout(binding = 3) readonly  buffer ActDs       { uint ads[]; } ads;

layout(push_constant) uniform PC {
    uint n; // rows
    uint k; // reduction length
    uint m; // tokens, also the row stride of the output
} pc;

// Signed dot of four packed int8 lanes. Q4K_DOT4 maps to OpSDot through
// SPV_KHR_integer_dot_product; otherwise unpack and multiply.
int q4k_dot4(uint q, uint a) {
#ifdef Q4K_DOT4
    return dotPacked4x8EXT(int(q), int(a));
#else
    const int p0 = int(q << 24u) >> 24;
    const int p1 = int(q << 16u) >> 24;
    const int p2 = int(q <<  8u) >> 24;
    const int p3 = int(q) >> 24;
    const int a0 = int(a << 24u) >> 24;
    const int a1 = int(a << 16u) >> 24;
    const int a2 = int(a <<  8u) >> 24;
    const int a3 = int(a) >> 24;
    return p0 * a0 + p1 * a1 + p2 * a2 + p3 * a3;
#endif
}

// Byte i of the 12 packed scale/min bytes stored in three words.
uint q4k_byte(uvec3 s, uint i) {
    const uint v = (i < 4u) ? s.x : ((i < 8u) ? s.y : s.z);
    return (v >> ((i & 3u) * 8u)) & 0xFFu;
}

// 6-bit subblock scale; bit layout of get_scale_min_k4 (ggml/src/ggml-quants.c:880).
uint q4k_sc(uvec3 s, uint j) {
    if (j < 4u) {
        return q4k_byte(s, j) & 63u;
    }
    return (q4k_byte(s, j + 4u) & 15u) | ((q4k_byte(s, j - 4u) >> 6u) << 4);
}

// 6-bit subblock min, same packing as q4k_sc.
uint q4k_mn(uvec3 s, uint j) {
    if (j < 4u) {
        return q4k_byte(s, j + 4u) & 63u;
    }
    return (q4k_byte(s, j + 4u) >> 4u) | ((q4k_byte(s, j) >> 6u) << 4);
}

void main() {
    const uint nsb  = pc.k / Q4K_QK;
    const uint nk32 = pc.k / 32u;
    const uint lane = gl_LocalInvocationID.x % Q4K_SUBGROUP;
    const uint sub  = gl_LocalInvocationID.x / Q4K_SUBGROUP;

    uint row[Q4K_ROWS];
    [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
        row[r] = gl_WorkGroupID.x * Q4K_TILE_N + r * Q4K_SUBGROUP + lane;
    }
    const uint tok0 = gl_WorkGroupID.y * Q4K_TILE_M + sub * Q4K_TOKENS;
    if (row[Q4K_ROWS - 1u] >= pc.n || tok0 + Q4K_TOKENS > pc.m) {
        return;
    }

    float acc[Q4K_ROWS][Q4K_TOKENS];
    [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < Q4K_TOKENS; ++t) {
            acc[r][t] = 0.0;
        }
    }

    const uint w_stride = nsb * Q4K_W_WORDS;
    const uint a_tok    = tok0 * nk32;

    for (uint sb = 0; sb < nsb; ++sb) {
        vec2 dm[Q4K_ROWS];
        uvec3 sc[Q4K_ROWS];
        [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
            const uint b = row[r] * w_stride + sb * Q4K_W_WORDS;
            dm[r] = unpackHalf2x16(wt.w[b]);
            sc[r] = uvec3(wt.w[b + 1u], wt.w[b + 2u], wt.w[b + 3u]);
        }

        [[unroll]] for (uint g = 0; g < Q4K_GROUPS; ++g) {
            // one group is 64 elements: subblock 2g holds the low nibbles of the 32 bytes
            const uint jl = 2u * g;
            const uint jh = jl + 1u;
            float f[Q4K_ROWS][2];
            float k[Q4K_ROWS][2];
            uint lo[Q4K_ROWS][8];
            uint hi[Q4K_ROWS][8];
            [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
                f[r][0] = dm[r].x * float(q4k_sc(sc[r], jl));
                f[r][1] = dm[r].x * float(q4k_sc(sc[r], jh));
                k[r][0] = dm[r].y * float(q4k_mn(sc[r], jl));
                k[r][1] = dm[r].y * float(q4k_mn(sc[r], jh));
                const uint b = row[r] * w_stride + sb * Q4K_W_WORDS + 4u + 8u * g;
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    const uint u = wt.w[b + i];
                    lo[r][i] = u & 0x0F0F0F0Fu;
                    hi[r][i] = (u >> 4) & 0x0F0F0F0Fu;
                }
            }

            const uint ab = a_tok + sb * 8u + jl;
            [[unroll]] for (uint t = 0; t < Q4K_TOKENS; ++t) {
                const uint bi = ab + t * nk32;
                // qs plane: two uvec4 per 32-element block; ds plane: f16 delta + biased int16 sum
                const uvec4 alo = aq.aq[bi * 2u];
                const uvec4 ahi = aq.aq[bi * 2u + 1u];
                const uvec4 blo = aq.aq[bi * 2u + 2u];
                const uvec4 bhi = aq.aq[bi * 2u + 3u];
                const uint dsl = ads.ads[bi];
                const uint dsh = ads.ads[bi + 1u];
                const float aql = unpackHalf2x16(dsl).x;
                const float aqh = unpackHalf2x16(dsh).x;
                const float suml = float(int(dsl >> 16u) - 32768);
                const float sumh = float(int(dsh >> 16u) - 32768);
                uint al[8];
                uint ah[8];
                al[0] = alo.x; al[1] = alo.y; al[2] = alo.z; al[3] = alo.w;
                al[4] = ahi.x; al[5] = ahi.y; al[6] = ahi.z; al[7] = ahi.w;
                ah[0] = blo.x; ah[1] = blo.y; ah[2] = blo.z; ah[3] = blo.w;
                ah[4] = bhi.x; ah[5] = bhi.y; ah[6] = bhi.z; ah[7] = bhi.w;
                int il[Q4K_ROWS];
                int ih[Q4K_ROWS];
                [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
                    il[r] = 0;
                    ih[r] = 0;
                }
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
                        il[r] += q4k_dot4(lo[r][i], al[i]);
                        ih[r] += q4k_dot4(hi[r][i], ah[i]);
                    }
                }
                [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
                    const float fl = f[r][0] * aql;
                    const float kl = k[r][0] * aql;
                    const float fh = f[r][1] * aqh;
                    const float kh = k[r][1] * aqh;
                    acc[r][t] += fl * float(il[r]) - kl * suml;
                    acc[r][t] += fh * float(ih[r]) - kh * sumh;
                }
            }
        }
    }

    [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < Q4K_TOKENS; ++t) {
            ob.o[row[r] * pc.m + tok0 + t] = acc[r][t];
        }
    }
}
