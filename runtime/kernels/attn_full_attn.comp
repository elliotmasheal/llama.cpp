#version 450
#extension GL_EXT_control_flow_attributes : require

// Flash-style causal attention over the f16 KV cache (M2-6d step 2).
//
// One workgroup is one (query head, query tile of 64) with 256 threads. head_dim is 256,
// which does not fit two shared-memory tiles at once on this device (32768 B), so the
// 256 dims are walked as **two 128-dim passes**: the partial dot products stay in
// registers, the K tile holds one half at a time (8.4 KiB for 32 keys), and the space
// that frees lets the key tile be 32 instead of 16. The same trick keeps V cheap: V is
// staged in sub-blocks of 8 keys (4 KiB), which is what the accumulate phase needs at a
// time. Splitting the dims across *workgroups* instead would need the two partial dots
// summed across workgroups, i.e. a global round trip per score block, so the split is
// inside one workgroup on purpose.
//
// Per KV block of 32 keys:
//   scores  S[t][u] = qscale * sum_d Q[t][d] K[u][d]    2 rows x 4 keys, two dim passes
//   softmax online:  m, l per row, P = exp(S - m), rescale O by exp(m_old - m)
//   accumulate       O[t][d] += sum_u P[t][u] V[u][d]   8 rows x 8 channels, 8-key V blocks
// then O/l and the sigmoid gate that the joint QG projection carries.

layout(local_size_x = 256) in;

const uint HD  = 256;   // head_dim
const uint BQ  = 64;    // query rows per workgroup
const uint BKV = 32;    // keys per tile
const uint KPAD = BKV + 1;              // padding: transposed reads stay conflict free
const uint VSUB = 8;    // keys staged at a time for the accumulate phase
const uint NH  = 16;    // n_head
const uint NKV = 2;     // n_kv

layout(push_constant) uniform PC {
    uint  pos0;      // position of the first token of the chunk
    uint  tokens;
    uint  kv_cap;    // tokens the KV cache holds
    uint  qg_ch;     // n_head * 2 * head_dim
    float kq_scale;
} pc;

layout(binding = 0) readonly  buffer QBuf  { float q[];   };   // [token][NH*HD]
layout(binding = 1) readonly  buffer KcBuf { uint  kc[];  };   // f16 pairs [kv][cap][HD]
layout(binding = 2) readonly  buffer VcBuf { uint  vc[];  };   // f16 pairs
layout(binding = 3) writeonly buffer OutBuf{ float dst[]; };   // [token][NH*HD]
layout(binding = 4) readonly  buffer QgBuf { float qg[];  };   // [token][qg_ch]

shared uint  kt[(HD / 4u) * KPAD];  // [d/2][u] of one 128-dim half, transposed pair words
shared uint  vt[VSUB * (HD / 2u)];  // [u][d/2] of VSUB keys
shared float sc[BQ * KPAD + BQ];    // [t][u] then the per-row rescale factors
shared float ml[2 * BQ];            // m[0..BQ), l[BQ..2BQ)

void main() {
    const uint tid  = gl_LocalInvocationID.x;
    const uint q0   = gl_WorkGroupID.x * BQ;
    const uint head = gl_WorkGroupID.y;
    if (q0 >= pc.tokens) {
        return;
    }
    const uint rows = min(BQ, pc.tokens - q0);
    const uint kvh  = head / (NH / NKV);
    const uint pos_end = pc.pos0 + pc.tokens;

    // thread -> 8 query rows x 8 channels for the accumulator
    const uint r0 = 8u * (tid >> 5u);
    const uint d0 = 8u * (tid & 31u);
    // thread -> 2 query rows x 4 keys for the scores
    const uint sr0 = 2u * (tid >> 3u);
    const uint sk  = 4u * (tid & 7u);

    if (tid < BQ) {
        ml[tid]      = -1e30f;
        ml[BQ + tid] = 0.0f;
    }
    float o[64];
    [[unroll]] for (uint i = 0; i < 64u; ++i) {
        o[i] = 0.0f;
    }
    barrier();

    const uint nkb = (pc.pos0 + q0 + rows + BKV - 1u) / BKV;   // causal: keys are absolute
    for (uint kb = 0; kb < nkb; ++kb) {
        const uint kbase = kb * BKV;

        // scores in two dim passes; the K half tile is (128 dims) x (32 keys) of pair words
        float s[8];
        [[unroll]] for (uint i = 0; i < 8u; ++i) {
            s[i] = 0.0f;
        }
        const uint qb0 = ((q0 + sr0 + 0u) * NH + head) * HD;
        const uint qb1 = ((q0 + sr0 + 1u) * NH + head) * HD;
        for (uint hf = 0; hf < 2u; ++hf) {
            const uint dbase = hf * 128u;
            for (uint idx = tid; idx < (HD / 4u) * BKV; idx += 256u) {
                const uint dp = idx / BKV;          // pair index inside the half
                const uint u  = idx % BKV;
                const uint kpos = kbase + u;
                kt[dp * KPAD + u] = kpos < pos_end
                    ? kc[(kvh * pc.kv_cap + kpos) * (HD / 2u) + dbase / 2u + dp]
                    : 0u;
            }
            barrier();
            for (uint dl = 0; dl < 128u; dl += 4u) {
                const vec2 a0 = unpackHalf2x16(kt[(dl / 2u) * KPAD + sk + 0u]);
                const vec2 a1 = unpackHalf2x16(kt[(dl / 2u) * KPAD + sk + 1u]);
                const vec2 a2 = unpackHalf2x16(kt[(dl / 2u) * KPAD + sk + 2u]);
                const vec2 a3 = unpackHalf2x16(kt[(dl / 2u) * KPAD + sk + 3u]);
                const vec2 b0 = unpackHalf2x16(kt[(dl / 2u + 1u) * KPAD + sk + 0u]);
                const vec2 b1 = unpackHalf2x16(kt[(dl / 2u + 1u) * KPAD + sk + 1u]);
                const vec2 b2 = unpackHalf2x16(kt[(dl / 2u + 1u) * KPAD + sk + 2u]);
                const vec2 b3 = unpackHalf2x16(kt[(dl / 2u + 1u) * KPAD + sk + 3u]);
                const uint g = dbase + dl;
                const float a_0 = q[qb0 + g], a_1 = q[qb0 + g + 1u], a_2 = q[qb0 + g + 2u], a_3 = q[qb0 + g + 3u];
                const float b_0 = q[qb1 + g], b_1 = q[qb1 + g + 1u], b_2 = q[qb1 + g + 2u], b_3 = q[qb1 + g + 3u];
                s[0] += a_0 * a0.x; s[0] += a_1 * a0.y; s[0] += a_2 * b0.x; s[0] += a_3 * b0.y;
                s[1] += a_0 * a1.x; s[1] += a_1 * a1.y; s[1] += a_2 * b1.x; s[1] += a_3 * b1.y;
                s[2] += a_0 * a2.x; s[2] += a_1 * a2.y; s[2] += a_2 * b2.x; s[2] += a_3 * b2.y;
                s[3] += a_0 * a3.x; s[3] += a_1 * a3.y; s[3] += a_2 * b3.x; s[3] += a_3 * b3.y;
                s[4] += b_0 * a0.x; s[4] += b_1 * a0.y; s[4] += b_2 * b0.x; s[4] += b_3 * b0.y;
                s[5] += b_0 * a1.x; s[5] += b_1 * a1.y; s[5] += b_2 * b1.x; s[5] += b_3 * b1.y;
                s[6] += b_0 * a2.x; s[6] += b_1 * a2.y; s[6] += b_2 * b2.x; s[6] += b_3 * b2.y;
                s[7] += b_0 * a3.x; s[7] += b_1 * a3.y; s[7] += b_2 * b3.x; s[7] += b_3 * b3.y;
            }
            barrier();
        }
        [[unroll]] for (uint r = 0; r < 2u; ++r) {
            const uint pos_q = pc.pos0 + q0 + sr0 + r;
            [[unroll]] for (uint j = 0; j < 4u; ++j) {
                const uint pos_k = kbase + sk + j;
                sc[(sr0 + r) * KPAD + sk + j] =
                    (pos_k <= pos_q) ? s[4u * r + j] * pc.kq_scale : -1e30f;
            }
        }
        barrier();

        // online softmax, one thread per query row
        if (tid < BQ) {
            float mx = -1e30f;
            for (uint u = 0; u < BKV; ++u) {
                mx = max(mx, sc[tid * KPAD + u]);
            }
            const float old  = ml[tid];
            const float mnew = max(old, mx);
            const float f    = exp(old - mnew);
            float sum = 0.0f;
            for (uint u = 0; u < BKV; ++u) {
                const float e = exp(sc[tid * KPAD + u] - mnew);
                sc[tid * KPAD + u] = e;
                sum += e;
            }
            ml[tid]      = mnew;
            ml[BQ + tid] = ml[BQ + tid] * f + sum;
            sc[BQ * KPAD + tid] = f;
        }
        barrier();

        // rescale the running output once per block, then add this block's keys in
        // sub-blocks of VSUB so V needs only 4 KiB of shared memory
        [[unroll]] for (uint r = 0; r < 8u; ++r) {
            const float f = sc[BQ * KPAD + r0 + r];
            [[unroll]] for (uint j = 0; j < 8u; ++j) {
                o[r * 8u + j] *= f;
            }
        }
        for (uint vs = 0; vs < BKV / VSUB; ++vs) {
            const uint u0 = vs * VSUB;
            for (uint idx = tid; idx < VSUB * (HD / 2u); idx += 256u) {
                const uint u  = idx / (HD / 2u);
                const uint dp = idx % (HD / 2u);
                const uint kpos = kbase + u0 + u;
                vt[idx] = kpos < pos_end ? vc[(kvh * pc.kv_cap + kpos) * (HD / 2u) + dp] : 0u;
            }
            barrier();
            for (uint u = 0; u < VSUB; ++u) {
                float v[8];
                const uint base = u * (HD / 2u) + d0 / 2u;
                [[unroll]] for (uint j = 0; j < 4u; ++j) {
                    const vec2 h = unpackHalf2x16(vt[base + j]);
                    v[2u * j]      = h.x;
                    v[2u * j + 1u] = h.y;
                }
                [[unroll]] for (uint r = 0; r < 8u; ++r) {
                    const float p = sc[(r0 + r) * KPAD + u0 + u];
                    [[unroll]] for (uint j = 0; j < 8u; ++j) {
                        o[r * 8u + j] += p * v[j];
                    }
                }
            }
            barrier();
        }
    }

    // write out: divide by the softmax mass, then the gate
    [[unroll]] for (uint r = 0; r < 8u; ++r) {
        if (r0 + r < rows) {
            const float inv = 1.0f / ml[BQ + r0 + r];
            const uint tok = q0 + r0 + r;
            [[unroll]] for (uint j = 0; j < 8u; ++j) {
                const uint ch = head * 2u * HD + HD + d0 + j;
                const float g = 1.0f / (1.0f + exp(-qg[tok * pc.qg_ch + ch]));
                dst[(tok * NH + head) * HD + d0 + j] = o[r * 8u + j] * inv * g;
            }
        }
    }
}
