#version 450
// out = a + b over `count` floats: the residual add of one layer (M2-6). One thread per
// element; the bases let a caller write into a slice of a larger buffer.

layout(local_size_x = 128) in;

layout(push_constant) uniform PC {
    uint count;
    uint abase;
    uint bbase;
    uint obase;
} pc;

layout(binding = 0) readonly  buffer ABuf { float a[]; } ab;
layout(binding = 1) readonly  buffer BBuf { float b[]; } bb;
layout(binding = 2) writeonly buffer OBuf { float o[]; } ob;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    ob.o[pc.obase + i] = ab.a[pc.abase + i] + bb.b[pc.bbase + i];
}
