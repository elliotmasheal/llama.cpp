#version 450
// Q8_0 x Q8_1 dense GEMM, LDS staged. The activation panel of the workgroup is copied
// into shared memory once per K-panel, so the 32 lanes stop re-reading the same token
// bytes from L2 (the previous kernel read them once per lane), and each lane holds a
// 4 row x 8 token register tile so one weight word feeds 8 tokens and one activation
// word feeds 4 rows. Weights stay in registers: every row belongs to one lane, so
// staging them would buy nothing.
//
// Weights are the prepared layout [k int8][k/8 bytes of f16 deltas] per row (see
// qrt_gemm_q8k_prepare), which keeps every load 4-byte aligned.

#extension GL_EXT_control_flow_attributes : enable
#ifdef Q4K_DOT4
#extension GL_EXT_integer_dot_product : require
#endif

#include "tiles.h"
#include "common.glsl"

#define ROWS   4u
#define TOKENS 8u
#define LANES  32u
#define SUBS   4u
#define TILE_N (ROWS * LANES)     // 128 rows per workgroup
#define TILE_M (TOKENS * SUBS)    // 32 tokens per workgroup
#define KSTEP  128u               // elements per panel
#define QWORDS (TILE_M * KSTEP / 4u)    // 1024 words of quants
#define DSWORDS (TILE_M * KSTEP / 32u)  // 128 words of deltas
#define THREADS (LANES * SUBS)          // 128

layout(local_size_x = THREADS) in;

layout(binding = 0) readonly  buffer WeightWords { uint w[]; } wt;
layout(binding = 1) readonly  buffer ActQs       { uvec4 aq[]; } aq;
layout(binding = 2) writeonly buffer Out         { float o[]; } ob;
layout(binding = 3) readonly  buffer ActDs       { uint ads[]; } ads;

layout(push_constant) uniform PC {
    uint n;
    uint k;
    uint m;
    uint wbase;   // byte offset of row 0 in the prepared buffer
    uint obase;
    uint abase;
} pc;

shared uint s_q[QWORDS];
shared uint s_d[DSWORDS];

void main() {
    const uint lane = gl_LocalInvocationID.x % LANES;
    const uint sub  = gl_LocalInvocationID.x / LANES;
    const uint tid  = gl_LocalInvocationID.x;

    uint row[ROWS];
    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        row[r] = gl_WorkGroupID.x * TILE_N + r * LANES + lane;
    }
    const uint tok0 = gl_WorkGroupID.y * TILE_M;
    // Workgroup uniform, so the barriers below are still reached by every thread.
    if (row[ROWS - 1u] >= pc.n || tok0 + TILE_M > pc.m) {
        return;
    }

    float acc[ROWS][TOKENS];
    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
            acc[r][t] = 0.0;
        }
    }

    const uint nk32 = pc.k / 32u;
    const uint stride = pc.k + pc.k / 8u;
    const uint panel_blocks = KSTEP / 32u;          // 4
    const uint my_token = sub * TOKENS;             // first token this lane reads

    for (uint k0 = 0; k0 < pc.k; k0 += KSTEP) {
        // One thread per (token, 32-element block): load the quants and the delta.
        {
            const uint t = tid / panel_blocks;
            const uint b = tid % panel_blocks;
            const uint ab = pc.abase + (tok0 + t) * nk32 + k0 / 32u + b;
            const uvec4 lo = aq.aq[ab * 2u];
            const uvec4 hi = aq.aq[ab * 2u + 1u];
            const uint base = t * (KSTEP / 4u) + b * 8u;
            s_q[base + 0u] = lo.x;
            s_q[base + 1u] = lo.y;
            s_q[base + 2u] = lo.z;
            s_q[base + 3u] = lo.w;
            s_q[base + 4u] = hi.x;
            s_q[base + 5u] = hi.y;
            s_q[base + 6u] = hi.z;
            s_q[base + 7u] = hi.w;
            s_d[t * panel_blocks + b] = ads.ads[ab];
        }
        barrier();

        [[unroll]] for (uint b = 0; b < panel_blocks; ++b) {
            uint q[ROWS][8];
            float dd[ROWS];
            [[unroll]] for (uint r = 0; r < ROWS; ++r) {
                const uint wq = (pc.wbase + row[r] * stride + (k0 + b * 32u)) >> 2u;
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    q[r][i] = wt.w[wq + i];
                }
                const uint wd = (pc.wbase + row[r] * stride + pc.k + (k0 / 32u + b) * 4u) >> 2u;
                dd[r] = unpackHalf2x16(wt.w[wd] & 0xFFFFu).x;
            }
            [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
                const uint sbase = (my_token + t) * (KSTEP / 4u) + b * 8u;
                uint aw[8];
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    aw[i] = s_q[sbase + i];
                }
                const float aq_scale =
                        unpackHalf2x16(s_d[(my_token + t) * panel_blocks + b]).x;
                [[unroll]] for (uint r = 0; r < ROWS; ++r) {
                    int sum = 0;
                    [[unroll]] for (uint i = 0; i < 8u; ++i) {
                        sum += qrt_dot4(q[r][i], aw[i]);
                    }
                    acc[r][t] += dd[r] * aq_scale * float(sum);
                }
            }
        }
        barrier();
    }

    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
            ob.o[pc.obase + row[r] * pc.m + tok0 + my_token + t] = acc[r][t];
        }
    }
}
