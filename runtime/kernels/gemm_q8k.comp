#version 450
// Q8_0 x Q8_1 dense GEMM, D-1 shape (M2-6b step 7). One lane owns ROWS output rows and
// TOKENS tokens; weights arrive four-to-a-word via uvec4 so a 32-element block costs two
// loads instead of eight, and the K panel is 256 elements so the barrier and the
// activation staging are amortized. This is the geometry the Q4_K expert kernel runs at
// 6.08-6.20 TFLOPS (RESULTS 28); the dense kernel was 3.35 with 4 rows and 8 single-word
// weight loads (RESULTS 53).
//
// Weights are the prepared layout [k int8][k/8 bytes of f16 deltas] per row, so every
// 16-byte group is aligned as long as k % 16 == 0 (2048 and 4096 are).

#extension GL_EXT_control_flow_attributes : enable
#ifdef Q4K_DOT4
#extension GL_EXT_integer_dot_product : require
#endif

#include "tiles.h"
#include "common.glsl"

#define ROWS   2u
#define TOKENS 8u
#define LANES  32u
#define SUBS   4u
#define TILE_N (ROWS * LANES)     // 64 rows per workgroup
#define TILE_M (TOKENS * SUBS)    // 32 tokens per workgroup
#define KSTEP  256u               // elements per panel
#define BLOCKS (KSTEP / 32u)      // 8 quant blocks of 32 elements
#define QWORDS (TILE_M * KSTEP / 4u)
#define THREADS (LANES * SUBS)

layout(local_size_x = THREADS) in;

layout(binding = 0) readonly  buffer WeightWords { uvec4 w4[]; } wt;
layout(binding = 1) readonly  buffer ActQs       { uvec4 aq[]; } aq;
layout(binding = 2) writeonly buffer Out         { float o[]; } ob;
layout(binding = 3) readonly  buffer ActDs       { uint ads[]; } ads;

layout(push_constant) uniform PC {
    uint n;
    uint k;
    uint m;
    uint wbase;   // byte offset of row 0 in the prepared buffer
    uint obase;
    uint abase;
} pc;

shared uint s_q[QWORDS];
shared uint s_d[TILE_M * BLOCKS];

void main() {
    const uint lane = gl_LocalInvocationID.x % LANES;
    const uint sub  = gl_LocalInvocationID.x / LANES;
    const uint tid  = gl_LocalInvocationID.x;

    uint row[ROWS];
    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        row[r] = gl_WorkGroupID.x * TILE_N + r * LANES + lane;
    }
    const uint tok0 = gl_WorkGroupID.y * TILE_M;
    // Workgroup uniform, so the barriers below are still reached by every thread.
    if (row[ROWS - 1u] >= pc.n || tok0 + TILE_M > pc.m) {
        return;
    }

    float acc[ROWS][TOKENS];
    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
            acc[r][t] = 0.0;
        }
    }

    const uint nk32 = pc.k / 32u;
    const uint stride = pc.k + pc.k / 8u;
    const uint my_token = sub * TOKENS;

    for (uint k0 = 0; k0 < pc.k; k0 += KSTEP) {
        // One thread per (token, block): quants and the f16 delta of that subblock.
        for (uint tt = tid; tt < TILE_M * BLOCKS; tt += THREADS) {
            const uint t = tt / BLOCKS;
            const uint b = tt % BLOCKS;
            const uint ab = pc.abase + (tok0 + t) * nk32 + k0 / 32u + b;
            const uvec4 lo = aq.aq[ab * 2u];
            const uvec4 hi = aq.aq[ab * 2u + 1u];
            const uint base = t * (KSTEP / 4u) + b * 8u;
            s_q[base + 0u] = lo.x;
            s_q[base + 1u] = lo.y;
            s_q[base + 2u] = lo.z;
            s_q[base + 3u] = lo.w;
            s_q[base + 4u] = hi.x;
            s_q[base + 5u] = hi.y;
            s_q[base + 6u] = hi.z;
            s_q[base + 7u] = hi.w;
            s_d[t * BLOCKS + b] = ads.ads[ab];
        }
        barrier();

        // The panel's deltas: 8 f16 values are 16 bytes, one aligned uvec4 per row.
        float dd[ROWS][BLOCKS];
        [[unroll]] for (uint r = 0; r < ROWS; ++r) {
            const uint dbyte = pc.wbase + row[r] * stride + pc.k + (k0 / 32u) * 4u;
            const uvec4 dv = wt.w4[dbyte >> 4u];
            dd[r][0] = unpackHalf2x16(dv.x).x;
            dd[r][1] = unpackHalf2x16(dv.x).y;
            dd[r][2] = unpackHalf2x16(dv.y).x;
            dd[r][3] = unpackHalf2x16(dv.y).y;
            dd[r][4] = unpackHalf2x16(dv.z).x;
            dd[r][5] = unpackHalf2x16(dv.z).y;
            dd[r][6] = unpackHalf2x16(dv.w).x;
            dd[r][7] = unpackHalf2x16(dv.w).y;
        }

        [[unroll]] for (uint b = 0; b < BLOCKS; ++b) {
            // One weight block of 32 elements is two aligned uvec4 words per row.
            uint q[ROWS][8];
            [[unroll]] for (uint r = 0; r < ROWS; ++r) {
                const uint wb = (pc.wbase + row[r] * stride + k0 + b * 32u) >> 4u;
                const uvec4 lo = wt.w4[wb];
                const uvec4 hi = wt.w4[wb + 1u];
                q[r][0] = lo.x; q[r][1] = lo.y; q[r][2] = lo.z; q[r][3] = lo.w;
                q[r][4] = hi.x; q[r][5] = hi.y; q[r][6] = hi.z; q[r][7] = hi.w;
            }
            [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
                const uint sbase = (my_token + t) * (KSTEP / 4u) + b * 8u;
                uint aw[8];
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    aw[i] = s_q[sbase + i];
                }
                const float aq_scale = unpackHalf2x16(s_d[(my_token + t) * BLOCKS + b]).x;
                [[unroll]] for (uint r = 0; r < ROWS; ++r) {
                    int sum = 0;
                    [[unroll]] for (uint i = 0; i < 8u; ++i) {
                        sum += qrt_dot4(q[r][i], aw[i]);
                    }
                    acc[r][t] += dd[r][b] * aq_scale * float(sum);
                }
            }
        }
        barrier();
    }

    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
            ob.o[pc.obase + row[r] * pc.m + tok0 + my_token + t] = acc[r][t];
        }
    }
}
