#version 450
// Q8_0 x Q8_1 dense GEMM, block-major weights (M2-6b step 8, D-3). The host repacks each
// 64-row tile so that, for one 32-element k block, the 32 quant bytes of the 64 rows are
// contiguous (gemm.cpp). A wave of 32 lanes then covers 32 consecutive slots, i.e. 1 KiB
// of one run, instead of 32 runs 2-4 KiB apart, which is what pinned the dense kernel at
// ~3.4 TFLOPS (RESULTS 53/54). Nothing else changes: same tiles, same dot4, same math.

#extension GL_EXT_control_flow_attributes : enable
#ifdef Q4K_DOT4
#extension GL_EXT_integer_dot_product : require
#endif

#include "tiles.h"
#include "common.glsl"

#ifndef Q8K_ROWS
#define Q8K_ROWS 2u
#endif
#ifndef Q8K_TOKENS
#define Q8K_TOKENS 8u
#endif
#ifndef Q8K_SUBS
#define Q8K_SUBS 4u
#endif
#define ROWS   Q8K_ROWS
#define TOKENS Q8K_TOKENS
#define LANES  32u
#define SUBS   Q8K_SUBS
#define QTILE  64u                // rows per weight tile, must match QK_TILE_ROWS
#define TILE_N (ROWS * LANES)     // 64 rows per workgroup
#define TILE_M (TOKENS * SUBS)    // 32 tokens per workgroup
#define KSTEP  256u               // elements per panel
#define BLOCKS (KSTEP / 32u)      // 8 quant blocks of 32 elements
#define QWORDS (TILE_M * KSTEP / 4u)
#define THREADS (LANES * SUBS)

layout(local_size_x = THREADS) in;

layout(binding = 0) readonly  buffer WeightWords { uint w[]; } wt;
layout(binding = 1) readonly  buffer ActQs       { uvec4 aq[]; } aq;
layout(binding = 2) writeonly buffer Out         { float o[]; } ob;
layout(binding = 3) readonly  buffer ActDs       { uint ads[]; } ads;

layout(push_constant) uniform PC {
    uint n;
    uint k;
    uint m;
    uint wbase;   // byte offset of this matrix inside the prepared buffer
    uint obase;
    uint abase;
    uint token_major; // 0 = [row][token] (the expert legs), 1 = [token][row] (the layer chain)
} pc;

shared uint s_q[QWORDS];
shared uint s_d[TILE_M * BLOCKS];

void main() {
    const uint lane = gl_LocalInvocationID.x % LANES;
    const uint sub  = gl_LocalInvocationID.x / LANES;
    const uint tid  = gl_LocalInvocationID.x;

    uint row[ROWS];
    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        row[r] = gl_WorkGroupID.x * TILE_N + r * LANES + lane;
    }
    const uint tok0 = gl_WorkGroupID.y * TILE_M;
    // Workgroup uniform, so the barriers below are still reached by every thread.
    if (row[ROWS - 1u] >= pc.n || tok0 + TILE_M > pc.m) {
        return;
    }

    float acc[ROWS][TOKENS];
    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
            acc[r][t] = 0.0;
        }
    }

    const uint nk32 = pc.k / 32u;
    const uint npad = (pc.n + QTILE - 1u) / QTILE * QTILE;
    const uint dbase = pc.wbase + npad * pc.k;   // delta plane follows the quant plane
    const uint my_token = sub * TOKENS;

    for (uint k0 = 0; k0 < pc.k; k0 += KSTEP) {
        // One thread per (token, block): quants and the f16 delta of that subblock.
        for (uint tt = tid; tt < TILE_M * BLOCKS; tt += THREADS) {
            const uint t = tt / BLOCKS;
            const uint b = tt % BLOCKS;
            const uint ab = pc.abase + (tok0 + t) * nk32 + k0 / 32u + b;
            const uvec4 lo = aq.aq[ab * 2u];
            const uvec4 hi = aq.aq[ab * 2u + 1u];
            const uint base = t * (KSTEP / 4u) + b * 8u;
            s_q[base + 0u] = lo.x;
            s_q[base + 1u] = lo.y;
            s_q[base + 2u] = lo.z;
            s_q[base + 3u] = lo.w;
            s_q[base + 4u] = hi.x;
            s_q[base + 5u] = hi.y;
            s_q[base + 6u] = hi.z;
            s_q[base + 7u] = hi.w;
            s_d[t * BLOCKS + b] = ads.ads[ab];
        }
        barrier();

        [[unroll]] for (uint b = 0; b < BLOCKS; ++b) {
            // One 32-element weight block per row: 8 words at a block-major slot, so the
            // wave reads 32 consecutive slots.
            uint q[ROWS][8];
            float dd[ROWS];
            [[unroll]] for (uint r = 0; r < ROWS; ++r) {
                const uint slot = (gl_WorkGroupID.x * nk32 + k0 / 32u + b) * QTILE +
                                  r * LANES + lane;
                const uint wq = (pc.wbase + slot * 32u) >> 2u;
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    q[r][i] = wt.w[wq + i];
                }
                const uint dbyte = dbase + slot * 2u;
                const uint word = wt.w[dbyte >> 2u];
                dd[r] = (dbyte & 2u) == 0u ? unpackHalf2x16(word).x : unpackHalf2x16(word).y;
            }
            [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
                const uint sbase = (my_token + t) * (KSTEP / 4u) + b * 8u;
                uint aw[8];
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    aw[i] = s_q[sbase + i];
                }
                const float aq_scale = unpackHalf2x16(s_d[(my_token + t) * BLOCKS + b]).x;
                [[unroll]] for (uint r = 0; r < ROWS; ++r) {
                    int sum = 0;
                    [[unroll]] for (uint i = 0; i < 8u; ++i) {
                        sum += qrt_dot4(q[r][i], aw[i]);
                    }
                    acc[r][t] += dd[r] * aq_scale * float(sum);
                }
            }
        }
        barrier();
    }

    // Row-major is what the expert legs and their checks read; the layer chain wants
    // [token][row], and a wave's lanes are consecutive rows, so those stores stay coalesced.
    [[unroll]] for (uint r = 0; r < ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < TOKENS; ++t) {
            const float v = acc[r][t];
            if (pc.token_major != 0u) {
                ob.o[pc.obase + (tok0 + my_token + t) * pc.n + row[r]] = v;
            } else {
                ob.o[pc.obase + row[r] * pc.m + tok0 + my_token + t] = v;
            }
        }
    }
}
