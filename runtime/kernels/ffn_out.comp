#version 450

// Last step of the layer (M2-6 FFN half): out = x + moe + shexp * sigmoid(gate), in place
// over the residual stream. The shared expert's own gate is the router kernel with n = 1.

layout(local_size_x = 256) in;

layout(binding = 0) readonly  buffer X { float x[]; };      // [tokens][n]
layout(binding = 1) readonly  buffer M { float moe[]; };    // [tokens][n]
layout(binding = 2) readonly  buffer S { float sh[]; };     // [tokens][n]
layout(binding = 3) readonly  buffer G { float gate[]; };   // [tokens]
layout(binding = 4) writeonly buffer O { float o[]; };      // [tokens][n]

layout(push_constant) uniform pc {
    uint n;     // tokens * n_embd
    uint nembd;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    const float g = gate[i / p.nembd];
    const float s = 1.0 / (1.0 + exp(-g));
    o[i] = x[i] + moe[i] + sh[i] * s;
}
