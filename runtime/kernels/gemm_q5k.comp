#version 450
// Q5_K (weights) x Q8_1 (activations) int8 dot GEMM. Same tile map and folding as the
// Q4_K kernel; Q5_K adds a 32-byte qh plane carrying the fifth bit of every weight
// (ggml-common.h block_q5_K, dequantize_row_q5_K at ggml-quants.c:1732). The 5-bit value
// is rebuilt as a byte (0..31) so one dot per word covers it: a byte value below 32 is
// a valid signed int8.

#extension GL_EXT_control_flow_attributes : enable
#ifdef Q4K_DOT4
#extension GL_EXT_integer_dot_product : require
#endif

#include "tiles.h"
#include "common.glsl"

layout(local_size_x = Q4K_WG_INVOCATIONS) in;

layout(binding = 0) readonly  buffer WeightWords { uint w[]; } wt;
layout(binding = 1) readonly  buffer ActQs       { uvec4 aq[]; } aq;
layout(binding = 2) writeonly buffer Out         { float o[]; } ob;
layout(binding = 3) readonly  buffer ActDs       { uint ads[]; } ads;

layout(push_constant) uniform PC {
    uint n;
    uint k;
    uint m;
    uint wbase;
    uint obase;
    uint abase;  // first activation block (token 0, reduction block 0)
    uint token_major; // 0 = [row][token], 1 = [token][row] (the layer chain)
} pc;

const uint W_WORDS = QRT_BLOCK_Q5K / 4u;   // d, dmin, 12 scales, 32 qh bytes, 128 qs bytes
const uint QH_WORD = 4u;                   // qh starts after the scale words
const uint QS_WORD = 12u;                  // qs start after the 8 qh words

void main() {
    const uint nsb  = pc.k / Q4K_QK;
    const uint nk32 = pc.k / 32u;
    const uint lane = gl_LocalInvocationID.x % Q4K_SUBGROUP;
    const uint sub  = gl_LocalInvocationID.x / Q4K_SUBGROUP;

    uint row[Q4K_ROWS];
    [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
        row[r] = gl_WorkGroupID.x * Q4K_TILE_N + r * Q4K_SUBGROUP + lane;
    }
    const uint tok0 = gl_WorkGroupID.y * Q4K_TILE_M + sub * Q4K_TOKENS;
    if (row[Q4K_ROWS - 1u] >= pc.n || tok0 + Q4K_TOKENS > pc.m) {
        return;
    }

    float acc[Q4K_ROWS][Q4K_TOKENS];
    [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < Q4K_TOKENS; ++t) {
            acc[r][t] = 0.0;
        }
    }

    const uint w_stride = nsb * W_WORDS;
    const uint a_tok    = pc.abase + tok0 * nk32;

    for (uint sb = 0; sb < nsb; ++sb) {
        vec2 dm[Q4K_ROWS];
        uvec3 sc[Q4K_ROWS];
        [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
            const uint b = pc.wbase + row[r] * w_stride + sb * W_WORDS;
            dm[r] = unpackHalf2x16(wt.w[b]);
            sc[r] = uvec3(wt.w[b + 1u], wt.w[b + 2u], wt.w[b + 3u]);
        }

        [[unroll]] for (uint g = 0; g < Q4K_GROUPS; ++g) {
            const uint jl = 2u * g;
            const uint jh = jl + 1u;
            float f[Q4K_ROWS][2];
            float k[Q4K_ROWS][2];
            uint lo[Q4K_ROWS][8];
            uint hi[Q4K_ROWS][8];
            [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
                f[r][0] = dm[r].x * float(qrt_sm_scale(sc[r], jl));
                f[r][1] = dm[r].x * float(qrt_sm_scale(sc[r], jh));
                k[r][0] = dm[r].y * float(qrt_sm_min(sc[r], jl));
                k[r][1] = dm[r].y * float(qrt_sm_min(sc[r], jh));
                const uint base = pc.wbase + row[r] * w_stride + sb * W_WORDS;
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    const uint u = wt.w[base + QS_WORD + 8u * g + i];
                    // The fifth bit lives in qh[4i..4i+3], one bit per element, bit 2g
                    // for the low nibble and 2g+1 for the high nibble.
                    const uint qh = wt.w[base + QH_WORD + i];
                    const uint bl = ((qh >> jl) & 0x01010101u) << 4u;
                    const uint bh = ((qh >> jh) & 0x01010101u) << 4u;
                    lo[r][i] = (u & 0x0F0F0F0Fu) | bl;
                    hi[r][i] = ((u >> 4) & 0x0F0F0F0Fu) | bh;
                }
            }

            const uint ab = a_tok + sb * 8u + jl;
            [[unroll]] for (uint t = 0; t < Q4K_TOKENS; ++t) {
                const uint bi = ab + t * nk32;
                const uvec4 alo = aq.aq[bi * 2u];
                const uvec4 ahi = aq.aq[bi * 2u + 1u];
                const uvec4 blo = aq.aq[bi * 2u + 2u];
                const uvec4 bhi = aq.aq[bi * 2u + 3u];
                const uint dsl = ads.ads[bi];
                const uint dsh = ads.ads[bi + 1u];
                const float aql = unpackHalf2x16(dsl).x;
                const float aqh = unpackHalf2x16(dsh).x;
                const float suml = float(int(dsl >> 16u) - 32768);
                const float sumh = float(int(dsh >> 16u) - 32768);
                uint al[8];
                uint ah[8];
                al[0] = alo.x; al[1] = alo.y; al[2] = alo.z; al[3] = alo.w;
                al[4] = ahi.x; al[5] = ahi.y; al[6] = ahi.z; al[7] = ahi.w;
                ah[0] = blo.x; ah[1] = blo.y; ah[2] = blo.z; ah[3] = blo.w;
                ah[4] = bhi.x; ah[5] = bhi.y; ah[6] = bhi.z; ah[7] = bhi.w;
                int il[Q4K_ROWS];
                int ih[Q4K_ROWS];
                [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
                    il[r] = 0;
                    ih[r] = 0;
                }
                [[unroll]] for (uint i = 0; i < 8u; ++i) {
                    [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
                        il[r] += qrt_dot4(lo[r][i], al[i]);
                        ih[r] += qrt_dot4(hi[r][i], ah[i]);
                    }
                }
                [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
                    const float fl = f[r][0] * aql;
                    const float kl = k[r][0] * aql;
                    const float fh = f[r][1] * aqh;
                    const float kh = k[r][1] * aqh;
                    acc[r][t] += fl * float(il[r]) - kl * suml;
                    acc[r][t] += fh * float(ih[r]) - kh * sumh;
                }
            }
        }
    }

    [[unroll]] for (uint r = 0; r < Q4K_ROWS; ++r) {
        [[unroll]] for (uint t = 0; t < Q4K_TOKENS; ++t) {
            ob.o[pc.token_major != 0u ? pc.obase + (tok0 + t) * pc.n + row[r]
                                 : pc.obase + row[r] * pc.m + tok0 + t] = acc[r][t];
        }
    }
}
