#version 450
#extension GL_EXT_control_flow_attributes : enable
// RMS norm of one token row, optionally followed by the Q8_1 activation packing the dense
// GEMM eats (M2-6 layer chain, first piece). One workgroup per token: 128 threads reduce
// the row, scale it, then each thread quantises one 32-element block. The planes match
// kernels/gemm.h: qs is 32 int8 per block in uvec4 pairs, ds is one word per block with the
// f16 delta in the low half and sum(q) + 32768 in the high half.
//
// The rounding is round-half-away-from-zero, the rule ggml's quantize_row_q8_1 uses; GLSL
// round() is round-half-to-even and would disagree on exact ties.

layout(local_size_x = 128) in;

layout(push_constant) uniform PC {
    uint  k;        // row length, multiple of 32
    uint  xbase;    // first element of token 0 in x
    uint  obase;    // first element of token 0 in xnorm
    uint  qsbase;   // first uvec4 of token 0 in qs
    uint  dsbase;   // first word of token 0 in ds
    float eps;
    uint  do_quant; // 0 = norm only
    uint  do_norm;  // 0 = copy x to out and only quantise (the layer's post-attention input)
    uint  do_out;   // 0 = skip the f32 row (the GEMM only needs the planes)
} pc;

layout(binding = 0) readonly  buffer XBuf   { float x[]; } xb;
layout(binding = 1) readonly  buffer WBuf   { float w[]; } wb;
layout(binding = 2) writeonly buffer OutBuf { float o[]; } ob;
layout(binding = 3) writeonly buffer QsBuf  { uvec4 qs[]; } qsb;
layout(binding = 4) writeonly buffer DsBuf  { uint ds[]; } dsb;

shared float red[128];

// Round-to-nearest-even fp32 -> binary16. packHalf2x16 is not usable here: this driver
// lowers it to v_cvt_pkrtz, which rounds toward zero, and the delta then sits one half
// ULP below what ggml's quantize_row_q8_1 writes (RESULTS 69).
uint f32_to_f16_rne(float f) {
    const uint x    = floatBitsToUint(f);
    const uint sign = (x >> 16) & 0x8000u;
    const uint mag  = x & 0x7FFFFFFFu;
    if (mag >= 0x7F800000u) {
        return sign | (mag > 0x7F800000u ? 0x7E00u : 0x7C00u);
    }
    if (mag >= 0x47800000u) {
        return sign | 0x7C00u;
    }
    if (mag < 0x38800000u) {
        if (mag < 0x33000000u) {
            return sign;
        }
        const uint shift = 126u - (mag >> 23);
        const uint mant  = (mag & 0x7FFFFFu) | 0x800000u;
        uint q = mant >> shift;
        const uint rem  = mant & ((1u << shift) - 1u);
        const uint hstep = 1u << (shift - 1u);
        if (rem > hstep || (rem == hstep && (q & 1u) != 0u)) {
            q++;
        }
        return sign | q;
    }
    uint mant = mag & 0x7FFFFFu;
    uint exp  = ((mag >> 23) - 127u) + 15u;
    const uint rem = mant & 0x1FFFu;
    mant >>= 13;
    if (rem > 0x1000u || (rem == 0x1000u && (mant & 1u) != 0u)) {
        mant++;
        if (mant == 0x400u) {
            mant = 0u;
            exp++;
            if (exp >= 31u) {
                return sign | 0x7C00u;
            }
        }
    }
    return sign | (exp << 10u) | mant;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint tok = gl_WorkGroupID.x;
    const uint base = pc.xbase + tok * pc.k;

    // do_norm = 0 is the pure quantise path: the layer feeds projections whose input is not
    // an rms norm output (the attention output before ssm_out / attn_output).
    float scale = 1.0;
    if (pc.do_norm != 0u) {
        float ss = 0.0;
        for (uint i = tid; i < pc.k; i += 128u) {
            const float v = xb.x[base + i];
            ss += v * v;
        }
        red[tid] = ss;
        barrier();
        [[unroll]] for (uint s = 64u; s > 0u; s >>= 1u) {
            if (tid < s) {
                red[tid] += red[tid + s];
            }
            barrier();
        }
        scale = 1.0 / sqrt(red[0] / float(pc.k) + pc.eps);
    }

    const uint o0 = pc.obase + tok * pc.k;
    if (pc.do_out != 0u) {
        for (uint i = tid; i < pc.k; i += 128u) {
            ob.o[o0 + i] = xb.x[base + i] * scale * (pc.do_norm != 0u ? wb.w[i] : 1.0);
        }
    }
    if (pc.do_quant == 0u) {
        return;
    }

    // One thread per 32-element block of the normalised row. The row is recomputed
    // instead of read back: out is writeonly, and another invocation wrote those slots.
    const uint blocks = pc.k / 32u;
    for (uint b = tid; b < blocks; b += 128u) {
        float v[32];
        float mx = 0.0;
        [[unroll]] for (uint i = 0; i < 32u; ++i) {
            const uint j = b * 32u + i;
            v[i] = xb.x[base + j] * scale * (pc.do_norm != 0u ? wb.w[j] : 1.0);
            mx = max(mx, abs(v[i]));
        }
        const float d = mx / 127.0;
        const float inv = d > 0.0 ? 1.0 / d : 0.0;
        int sum = 0;
        [[unroll]] for (uint i = 0; i < 32u; ++i) {
            float y = clamp(v[i] * inv, -127.0, 127.0);
            y = sign(y) * floor(abs(y) + 0.5);
            v[i] = y;
            sum += int(y);
        }
        uvec4 lo;
        uvec4 hi;
        [[unroll]] for (uint i = 0; i < 4u; ++i) {
            lo[i] = (uint(int(v[i * 4u + 0u])) & 0xFFu) |
                    ((uint(int(v[i * 4u + 1u])) & 0xFFu) << 8) |
                    ((uint(int(v[i * 4u + 2u])) & 0xFFu) << 16) |
                    ((uint(int(v[i * 4u + 3u])) & 0xFFu) << 24);
            hi[i] = (uint(int(v[16u + i * 4u + 0u])) & 0xFFu) |
                    ((uint(int(v[16u + i * 4u + 1u])) & 0xFFu) << 8) |
                    ((uint(int(v[16u + i * 4u + 2u])) & 0xFFu) << 16) |
                    ((uint(int(v[16u + i * 4u + 3u])) & 0xFFu) << 24);
        }
        const uint ab = pc.qsbase + tok * blocks + b;
        qsb.qs[ab * 2u] = lo;
        qsb.qs[ab * 2u + 1u] = hi;
        const uint dh = f32_to_f16_rne(d);
        dsb.ds[pc.dsbase + tok * blocks + b] = (dh & 0xFFFFu) | (uint(sum + 32768) << 16);
    }
}
