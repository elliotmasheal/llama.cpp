#version 450

#include "types.glsl"
#include "generic_binary_head.glsl"

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

// dim 0 with row-contiguous sources: one workgroup per (i1,i2,i3) row, two flat
// segment copies. The host selects it only when all three rows are contiguous, so
// the row base is a plain stride sum and no i0..i3 decomposition is needed.
#define FAST_UNROLL 4u

void concat_rows() {
    const uint tid  = gl_LocalInvocationID.x;
    const uint n_a  = p.ne00;
    const uint n_b  = p.ne10;
    const uint a_base = get_aoffset() + gl_WorkGroupID.z * p.nb03 + gl_WorkGroupID.y * p.nb02 + gl_WorkGroupID.x * p.nb01;
    const uint b_base = get_boffset() + gl_WorkGroupID.z * p.nb13 + gl_WorkGroupID.y * p.nb12 + gl_WorkGroupID.x * p.nb11;
    const uint d_base = get_doffset() + gl_WorkGroupID.z * p.nb23 + gl_WorkGroupID.y * p.nb22 + gl_WorkGroupID.x * p.nb21;
    const uint step = gl_WorkGroupSize.x * FAST_UNROLL;

    // k-major so consecutive lanes touch consecutive units; FAST_UNROLL loads in flight
    for (uint base = 0; base < n_a; base += step) {
        [[unroll]] for (uint k = 0; k < FAST_UNROLL; ++k) {
            const uint col = base + k * gl_WorkGroupSize.x + tid;
            if (col < n_a) {
                data_d[d_base + col] = data_a[a_base + col];
            }
        }
    }
    for (uint base = 0; base < n_b; base += step) {
        [[unroll]] for (uint k = 0; k < FAST_UNROLL; ++k) {
            const uint col = base + k * gl_WorkGroupSize.x + tid;
            if (col < n_b) {
                data_d[d_base + n_a + col] = data_b[b_base + col];
            }
        }
    }
}

void main() {
    if (p.param1 > 0.0f) {
        concat_rows();
        return;
    }

    const uint idx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
    const int dim = p.param3;

    if (idx >= p.ne) {
        return;
    }

    const uint i3 = idx / (p.ne22*p.ne21*p.ne20);
    const uint i3_offset = i3 * p.ne22*p.ne21*p.ne20;
    const uint i2 = (idx - i3_offset) / (p.ne21*p.ne20);
    const uint i2_offset = i2*p.ne21*p.ne20;
    const uint i1 = (idx - i3_offset - i2_offset) / p.ne20;
    const uint i0 = idx - i3_offset - i2_offset - i1*p.ne20;

    uint o[4] = {0, 0, 0, 0};
    o[dim] = dim == 0 ? p.ne00 : (dim == 1 ? p.ne01 : (dim == 2 ? p.ne02 : p.ne03));

    const uint src0_idx = i3*p.nb03 + i2*p.nb02 + i1*p.nb01 + i0*p.nb00;
    const uint src1_idx = (i3 - o[3])*p.nb13 + (i2 - o[2])*p.nb12 + (i1 - o[1])*p.nb11 + (i0 - o[0])*p.nb10;
    const uint dst_idx = i3*p.nb23 + i2*p.nb22 + i1*p.nb21 + i0*p.nb20;

    const bool is_src0 = i0 < p.ne00 && i1 < p.ne01 && i2 < p.ne02 && i3 < p.ne03;

#ifndef OPTIMIZATION_ERROR_WORKAROUND
    data_d[get_doffset() + dst_idx] = D_TYPE(is_src0 ? data_a[get_aoffset() + src0_idx] : data_b[get_boffset() + src1_idx]);
#else
    if (is_src0) {
        data_d[get_doffset() + dst_idx] = data_a[get_aoffset() + src0_idx];
    } else {
        data_d[get_doffset() + dst_idx] = data_b[get_boffset() + src1_idx];
    }
#endif
}
